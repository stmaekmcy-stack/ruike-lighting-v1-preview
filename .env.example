# Public build configuration
VITE_DEPLOYMENT_TARGET=preview
VITE_BASE_PATH=/
VITE_SITE_URL=https://example.com/
VITE_ALLOW_INDEXING=false
VITE_PROJECT_FORM_ENDPOINT=
VITE_FORM_SIMULATE_FAILURE=false
VITE_COMPANY_PHONE=
VITE_WECHAT_ID=
VITE_COMPANY_EMAIL=

# Server-only mail configuration. Never prefix these values with VITE_.
PORT=8787
TRUST_PROXY=true
ALLOWED_ORIGINS=https://example.com,https://www.example.com
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_MS=600000
MAX_BODY_BYTES=16384
CONTACT_RECEIVER_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_VERIFY_ON_START=true
