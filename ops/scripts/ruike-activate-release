#!/usr/bin/env bash
set -Eeuo pipefail

if [ "$(id -u)" -ne 0 ]; then
  echo "Run as root." >&2
  exit 1
fi

release_id="${1:-}"
archive_path="${2:-}"
lead_service_enabled="${3:-false}"
release_root="/srv/ruike-lighting/releases"
current_link="/srv/ruike-lighting/current"
previous_link="/srv/ruike-lighting/previous"

if [[ ! "$release_id" =~ ^[0-9a-f]{7,40}$ ]]; then
  echo "Invalid release id." >&2
  exit 1
fi

if [ "$archive_path" != "/tmp/ruike-${release_id}.tar.gz" ]; then
  echo "Release archive must match the approved release id." >&2
  exit 1
fi

if [ ! -f "$archive_path" ]; then
  echo "Release archive not found." >&2
  exit 1
fi

if [ "$lead_service_enabled" != "true" ] && [ "$lead_service_enabled" != "false" ]; then
  echo "Lead service flag must be true or false." >&2
  exit 1
fi

if tar -tzf "$archive_path" | grep -E '(^/|(^|/)\.\.(/|$))' >/dev/null; then
  echo "Unsafe path found in release archive." >&2
  exit 1
fi

# Release archives contain only regular files and directories, never links or devices.
if tar -tvzf "$archive_path" | grep -E '^[^d-]' >/dev/null; then
  echo "Unsupported file type found in release archive." >&2
  exit 1
fi

release_dir="$release_root/$release_id"
if [ -e "$release_dir" ]; then
  echo "Release already exists: $release_dir" >&2
  exit 1
fi

install -d -m 0755 "$release_root"
install -d -m 0755 "$release_dir"
tar -xzf "$archive_path" -C "$release_dir"
rm -f "$archive_path"

test -f "$release_dir/dist/index.html"
test -f "$release_dir/dist/healthz.json"
test -f "$release_dir/server/lead-service.mjs"
test -d "$release_dir/node_modules/nodemailer"
/usr/bin/node --check "$release_dir/server/lead-service.mjs"
printf '%s\n' "$lead_service_enabled" > "$release_dir/.lead-service-enabled"
chown -R root:www-data "$release_dir"
chmod -R u=rwX,g=rX,o=rX "$release_dir"

nginx -t

old_target=""
old_lead_service_enabled="false"
if [ -L "$current_link" ]; then
  old_target="$(readlink -f "$current_link")"
fi

if [ -n "$old_target" ] && [ -f "$old_target/.lead-service-enabled" ]; then
  old_lead_service_enabled="$(sed -n '1p' "$old_target/.lead-service-enabled")"
fi

if [ -n "$old_target" ] && [[ "$old_target" == "$release_root/"* ]]; then
  ln -sfn "$old_target" "$previous_link"
fi

ln -s "$release_dir" "${current_link}.next"
mv -Tf "${current_link}.next" "$current_link"

set_lead_service_mode() {
  local enabled="$1"
  if [ "$enabled" = "true" ]; then
    systemctl enable ruike-lead.service >/dev/null 2>&1
    systemctl restart ruike-lead.service
    for attempt in {1..15}; do
      if curl --fail --silent --max-time 2 http://127.0.0.1:8787/healthz >/dev/null; then return 0; fi
      sleep 1
    done
    return 1
  else
    systemctl disable --now ruike-lead.service
  fi
}

restore_previous_release() {
  if [ -n "$old_target" ] && [[ "$old_target" == "$release_root/"* ]]; then
    ln -sfn "$old_target" "${current_link}.next"
    mv -Tf "${current_link}.next" "$current_link"
    set_lead_service_mode "$old_lead_service_enabled" || true
  else
    rm -f "$current_link"
    systemctl disable --now nginx ruike-lead.service || true
  fi
}

if ! set_lead_service_mode "$lead_service_enabled"; then
  restore_previous_release
  echo "Lead service health check failed; previous release restored." >&2
  exit 1
fi

if ! nginx -t || ! systemctl enable nginx || ! systemctl reload-or-restart nginx; then
  restore_previous_release
  systemctl reload nginx || true
  echo "Nginx reload failed; previous release restored." >&2
  exit 1
fi

echo "Activated release $release_id"
