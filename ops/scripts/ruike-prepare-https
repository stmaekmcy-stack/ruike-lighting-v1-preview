#!/usr/bin/env bash
# Administrator-only, first-launch preparation. Never activates a site release.
set -Eeuo pipefail
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
umask 077

fail() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
[ "$(id -u)" = 0 ] || fail 'Run from the existing administrator terminal with sudo.'
[ "$#" = 0 ] || fail 'This reviewed script takes no arguments.'
for tool in flock ss awk grep stat readlink sha256sum cmp getent sort openssl certbot nginx systemctl curl install mktemp; do
  command -v "$tool" >/dev/null || fail "Required tool is unavailable: $tool"
done

pending=/etc/nginx/sites-available/ruike-lighting.conf.pending
approved_sha=ab7e723db22bf37848675a70d7071476c493ce5024af3822d4bca74b06d91e31
config=/etc/nginx/sites-available/ruike-lighting.conf
enabled=/etc/nginx/sites-enabled/ruike-lighting.conf
default_link=/etc/nginx/sites-enabled/default
renewal=/etc/letsencrypt/renewal/ruikelight.com.conf
cert_dir=/etc/letsencrypt/live/ruikelight.com
webroot=/var/www/letsencrypt
report_dir=/var/lib/ruike-lighting
report="$report_dir/https-readiness.txt"
backup=""
runtime=""
probe=""
config_changed=false
link_created=false
default_moved=false
renewal_changed=false
prepared=false

ports_busy() { ss -H -lnt | awk '{print $4}' | grep -Eq ':(80|443)$'; }
safe_dir() {
  [ ! -L "$1" ] && [ -d "$1" ] || fail "Unsafe directory: $1"
  [ "$(readlink -f "$1")" = "$1" ] || fail "Symlinked directory: $1"
  [ "$(stat -c %u "$1")" = 0 ] || fail "Directory is not root-owned: $1"
  local mode
  mode="$(stat -c %a "$1")"
  [ "$((8#$mode & 022))" = 0 ] || fail "Directory is writable by another user: $1"
}
safe_file() {
  [ ! -L "$1" ] && [ -f "$1" ] || fail "Unsafe file: $1"
  [ "$(stat -c %u "$1")" = 0 ] || fail "File is not root-owned: $1"
  local mode
  mode="$(stat -c %a "$1")"
  [ "$((8#$mode & 022))" = 0 ] || fail "File is writable by another user: $1"
}
stop_acme() {
  if [ -n "$runtime" ] && [ -f "$runtime/acme.pid" ]; then
    nginx -p "$runtime/" -c "$runtime/acme.conf" -s stop
    for attempt in {1..20}; do
      [ ! -f "$runtime/acme.pid" ] && return 0
      sleep 0.2
    done
    return 1
  fi
}
cleanup() {
  local result=$?
  trap - EXIT INT TERM
  set +e
  stop_acme || { printf 'Temporary ACME listener needs administrator inspection.\n' >&2; result=1; }
  if [ -n "$probe" ]; then rm -f -- "$probe"; fi
  if [ "$prepared" != true ]; then
    if [ "$link_created" = true ]; then rm -f -- "$enabled"; fi
    if [ "$config_changed" = true ]; then
      if [ -f "$backup/site.conf" ]; then cp -p "$backup/site.conf" "$config"; else rm -f -- "$config"; fi
    fi
    if [ "$default_moved" = true ]; then mv "$backup/default-link" "$default_link"; fi
    if [ "$renewal_changed" = true ]; then cp -p "$backup/renewal.conf" "$renewal"; fi
    [ -z "$backup" ] || printf 'Preparation did not complete. Recovery backup: %s\n' "$backup" >&2
  fi
  exit "$result"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

exec 9>/run/lock/ruike-https-prepare.lock
flock -n 9 || fail 'Another HTTPS preparation is running.'
for directory in /etc/nginx/sites-available /etc/nginx/sites-enabled /etc/letsencrypt/renewal /etc/ruike-lighting /var/www /var/lib; do safe_dir "$directory"; done
safe_file "$pending"
safe_file "$renewal"
[ "$(sha256sum "$pending" | awk '{print $1}')" = "$approved_sha" ] || fail 'Pending Nginx configuration does not match the reviewed version.'
[ ! -e /srv/ruike-lighting/current ] && [ ! -L /srv/ruike-lighting/current ] || fail 'A release already exists. Do not run first-launch preparation.'
if systemctl is-active --quiet nginx || ports_busy; then fail 'A web service is already running; leave it untouched.'; fi
systemctl is-enabled --quiet certbot.timer || fail 'Existing Certbot timer is not enabled.'
systemctl is-active --quiet certbot.timer || fail 'Existing Certbot timer is not active.'

shopt -s nullglob
for site in /etc/nginx/sites-enabled/*; do
  case "$site" in
    "$default_link") [ -L "$site" ] && [ "$(readlink "$site")" = /etc/nginx/sites-available/default ] || fail 'Unknown default virtual host; inspect manually.' ;;
    "$enabled") [ -L "$site" ] && [ "$(readlink "$site")" = "$config" ] || fail 'Unknown Ruike site link; inspect manually.' ;;
    *) fail "Unrelated enabled virtual host: $site" ;;
  esac
done
if [ -e "$config" ] || [ -L "$config" ]; then safe_file "$config"; cmp -s "$pending" "$config" || fail 'Existing Ruike configuration differs; inspect manually.'; fi
for domain in ruikelight.com www.ruikelight.com; do
  [ "$(getent ahostsv4 "$domain" | awk '{print $1}' | sort -u)" = 124.220.205.94 ] || fail "Unexpected IPv4 DNS for $domain"
done

# Read the key only inside this root process; output public certificate facts only.
for part in cert chain fullchain privkey; do test -s "$cert_dir/$part.pem" || fail "Certificate component is missing: $part"; done
openssl x509 -in "$cert_dir/cert.pem" -noout -checkend 604800
for domain in ruikelight.com www.ruikelight.com; do
  openssl verify -purpose sslserver -verify_hostname "$domain" -untrusted "$cert_dir/chain.pem" "$cert_dir/cert.pem"
done
cert_key="$(openssl x509 -in "$cert_dir/cert.pem" -pubkey -noout | openssl sha256)"
private_key="$(openssl pkey -in "$cert_dir/privkey.pem" -pubout | openssl sha256)"
[ "$cert_key" = "$private_key" ] || fail 'Certificate and private key do not match.'

if [ ! -e /etc/ruike-lighting/ops-backups ]; then install -d -m 0750 /etc/ruike-lighting/ops-backups; fi
safe_dir /etc/ruike-lighting/ops-backups
backup="$(mktemp -d /etc/ruike-lighting/ops-backups/https-XXXXXX)"
cp -p "$renewal" "$backup/renewal.conf"
if [ -f "$config" ]; then cp -p "$config" "$backup/site.conf"; fi
if [ ! -e "$report_dir" ]; then install -d -m 0755 "$report_dir"; fi
safe_dir "$report_dir"
if [ -e "$report" ] || [ -L "$report" ]; then safe_file "$report"; mv "$report" "$backup/prior-readiness.txt"; fi
for directory in "$webroot" "$webroot/.well-known" "$webroot/.well-known/acme-challenge"; do
  if [ ! -e "$directory" ]; then install -d -m 0755 "$directory"; fi
  safe_dir "$directory"
done

runtime="$(mktemp -d /run/ruike-acme-XXXXXX)"
cat > "$runtime/acme.conf" <<EOF
user www-data;
pid $runtime/acme.pid;
error_log $runtime/error.log warn;
events { worker_connections 64; }
http {
    access_log off;
    server {
        listen 80;
        listen [::]:80;
        server_name ruikelight.com www.ruikelight.com;
        location ^~ /.well-known/acme-challenge/ {
            root $webroot;
            try_files \$uri =404;
        }
        location / { return 404; }
    }
}
EOF
nginx -p "$runtime/" -c "$runtime/acme.conf" -t
nginx -p "$runtime/" -c "$runtime/acme.conf"
probe="$(mktemp "$webroot/.well-known/acme-challenge/ruike-check-XXXXXX")"
printf 'ruike-acme-preflight' > "$probe"
chmod 0644 "$probe"
[ "$(curl --noproxy '*' --fail --silent --show-error --max-time 5 -H 'Host: ruikelight.com' "http://127.0.0.1/.well-known/acme-challenge/${probe##*/}")" = ruike-acme-preflight ] || fail 'Local ACME path failed.'
[ "$(curl --noproxy '*' --silent --show-error --max-time 5 -o /dev/null -w '%{http_code}' -H 'Host: ruikelight.com' http://127.0.0.1/)" = 404 ] || fail 'Temporary listener must not expose a homepage.'

# Reconfigure performs a staging renewal before persisting new parameters.
# No --agree-tos, forced issuance, or real-site start is allowed here.
renewal_changed=true
certbot reconfigure --non-interactive --cert-name ruikelight.com \
  --webroot --webroot-path "$webroot" \
  --deploy-hook '/usr/bin/systemctl reload nginx'
grep -Eq '^authenticator[[:space:]]*=[[:space:]]*webroot[[:space:]]*$' "$renewal" || fail 'Webroot renewal was not saved.'
grep -Fq 'webroot_path = /var/www/letsencrypt' "$renewal" || fail 'Unexpected saved webroot.'
grep -Eq '^(deploy_hook|renew_hook) = /usr/bin/systemctl reload nginx$' "$renewal" || fail 'Renewal reload hook was not saved.'
stop_acme || fail 'Temporary ACME listener did not stop.'
ports_busy && fail 'A public web port remains open after the renewal test.'

# Prepare only. The separately approved release command starts the real site.
if [ -L "$default_link" ]; then mv "$default_link" "$backup/default-link"; default_moved=true; fi
config_changed=true
install -m 0644 "$pending" "$config"
if [ ! -L "$enabled" ]; then ln -s "$config" "$enabled"; link_created=true; fi
nginx -t
if systemctl is-active --quiet nginx || ports_busy; then fail 'Production must remain inactive until final approval.'; fi

report_tmp="$(mktemp "$report_dir/.https-readiness-XXXXXX")"
{
  printf 'checked_at=%s\nstatus=prepared_not_published\n' "$(date -u +%FT%TZ)"
  printf 'certificate_hosts=ruikelight.com,www.ruikelight.com\n'
  openssl x509 -in "$cert_dir/cert.pem" -noout -dates -issuer -fingerprint -sha256
  printf 'certificate_chain=verified\nprivate_key_match=verified\nrenewal=webroot\nrenewal_staging_test=passed\n'
  printf 'certbot_timer=enabled_active\nnginx_config=verified\nwebsite_active=false\n'
  printf 'backup=%s\n' "$backup"
} > "$report_tmp"
chmod 0644 "$report_tmp"
mv -T "$report_tmp" "$report"
prepared=true
printf 'HTTPS preparation passed. The public website is still OFF.\nReport: %s\n' "$report"
